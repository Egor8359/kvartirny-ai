# development | test | preview | production
APP_ENV=development
# Оставьте пустым для локальной SQLite. Для Supabase задайте адрес transaction pooler.
DATABASE_URL=
DB_SSL_MODE=require
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=deepseek/deepseek-v3.2
COOKIE_SECURE=false
# В preview/production: полный HTTPS-адрес именно этого окружения, без слеша в конце
PUBLIC_ORIGIN=
